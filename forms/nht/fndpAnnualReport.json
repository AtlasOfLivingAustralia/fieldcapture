{
  "name": "FNDP Annual Report",
  "sections": [
    {
      "class": "au.org.ala.ecodata.FormSection",
      "id": null,
      "collapsedByDefault": false,
      "modelName": null,
      "name": "FNDP Annual Report",
      "optional": false,
      "optionalQuestionText": null,
      "template": {
        "dataModel": [
          {
            "dataType": "text",
            "name": "keyAchievements",
            "validate": "required,maxSize[1250]"
          },
          {
            "dataType": "text",
            "name": "adaptiveManagementActions",
            "constraints": [
              "Yes",
              "No"
            ],
            "validate": "required"
          },
          {
            "dataType": "text",
            "name": "noAdaptiveManagementActions",
            "behaviour": [
              {
                "condition": "adaptiveManagementActions == \"No\"",
                "type": "enable"
              }
            ],
            "validate": "maxSize[1250]"
          },
          {
            "dataType": "text",
            "name": "reviewedAndUpdatedQ3",
            "constraints": [
              "Yes",
              "No"
            ],
            "validate": "required"
          },
          {
            "dataType": "text",
            "name": "reviewedAndNoChangeQ3",
            "constraints": [
              "Yes",
              "No"
            ],
            "behaviour": [
              {
                "condition": "reviewedAndUpdatedQ3 == \"No\"",
                "type": "enable_and_clear"
              }
            ],
            "validate": "required"
          },
          {
            "dataType": "text",
            "name": "reviewedAndUpdatedQ5",
            "constraints": [
              "Yes",
              "No"
            ],
            "validate": "required"
          },
          {
            "dataType": "text",
            "name": "reviewedAndNoChangeQ5",
            "constraints": [
              "Yes",
              "No"
            ],
            "behaviour": [
              {
                "condition": "reviewedAndUpdatedQ5 == \"No\"",
                "type": "enable_and_clear"
              }
            ],
            "validate": "required"
          },
          {
            "dataType": "number",
            "name": "totalFteEquivalent",
            "decimalPlaces": 2,
            "validate": "min[0]",
            "description": ""
          },
          {
            "dataType": "text",
            "name": "totalFteIsCorrect",
            "constraints": [
              "Yes",
              "No"
            ],
            "validate": "required"
          },
          {
            "dataType": "number",
            "name": "updatedTotalFteEquivalent",
            "decimalPlaces": 2,
            "validate": "min[0]",
            "behaviour": [
              {
                "condition": "totalFteIsCorrect == \"No\"",
                "type": "enable"
              }
            ]
          },
          {
            "dataType": "text",
            "name": "fteComments",
            "validate": "maxSize[1250]",
            "behaviour": [
              {
                "condition": "totalFteIsCorrect == \"No\"",
                "type": "enable"
              }
            ]
          },
          {
            "columns": [
              {
                "dataType": "text",
                "name": "serviceName"
              },
              {
                "dataType": "text",
                "name": "targetMeasure",
                "description": "The target measure identified in the MERI plan"
              },
              {
                "dataType": "text",
                "name": "scoreId",
                "description": "Identifier for the target measure"
              },
              {
                "dataType": "text",
                "name": "annualTarget",
                "description": "The minimum annual target specified in the MERI plan for the target measure"
              },
              {
                "dataType": "text",
                "name": "result",
                "description": "The actual progress towards the target this financial year"
              },
              {
                "dataType": "text",
                "name": "reasonTargetNotMet",
                "behaviour": [
                  {
                    "condition": "result < annualTarget or result > annualTarget",
                    "type": "enable_and_clear"
                  }
                ],
                "validate": "required"
              }
            ],
            "dataType": "list",
            "name": "minimumAnnualTargetsNotMet"
          },
          {
            "name": "communicationMaterialByType",
            "dataType": "list",
            "columns": [
              {
                "name": "psoCommunicationDetails",
                "dataType": "list",
                "allowRowDelete": "false",
                "columns": [
                  {
                    "dataType": "stringList",
                    "name": "communicationMaterialType",
                    "constraints": [
                      "Advertising",
                      "Extension materials",
                      "Flyers and brochures",
                      "Media release",
                      "Newsletters",
                      "Newspaper articles",
                      "Publishing reports",
                      "Social media",
                      "Other"
                    ]
                  },
                  {
                    "dataType": "text",
                    "name": "communicationTitle"
                  },
                  {
                    "dataType": "text",
                    "name": "communicationPurpose"
                  },
                  {
                    "dataType": "date",
                    "name": "publishedDate"
                  },
                  {
                    "dataType": "text",
                    "name": "link"
                  }
                ]
              },
              {
                "dataType": "text",
                "name": "communicationMaterialType"
              },
              {
                "dataType": "number",
                "name": "numberCommunicationMaterialsType"
              }
            ]
          },
          {
            "dataType": "list",
            "name": "psoCommunicationDetailsExtra",
            "columns": [
              {
                "dataType": "text",
                "name": "communicationMaterialTypeExtra",
                "constraints": [
                  "Advertising",
                  "Event Flyers and Brochures",
                  "Media release",
                  "Newsletters",
                  "Newspaper articles",
                  "Publishing reports",
                  "Social media",
                  "Other"
                ],
                "validate": "required"
              },
              {
                "dataType": "text",
                "name": "communicationTitleExtra",
                "validate": "required,maxSize[100]"
              },
              {
                "dataType": "text",
                "name": "communicationPurposeExtra",
                "validate": "required,maxSize[4000]"
              },
              {
                "dataType": "date",
                "name": "publishedDateExtra",
                "validate": "required,past[now]"
              },
              {
                "dataType": "text",
                "name": "linkExtra"
              }
            ]
          },
          {
            "name": "engagementsByType",
            "dataType": "list",
            "columns": [
              {
                "name": "engagementDetails",
                "dataType": "list",
                "columns": [
                  {
                    "dataType": "stringList",
                    "name": "engagementType",
                    "constraints": [
                      "One-on-one technical advice",
                      "Negotiations with the community, etc.",
                      "Facilitating/Hosting on-ground trials/demos",
                      "Hosting workshops",
                      "Facilitating/Hosting conferences/seminars"
                    ]
                  },
                  {
                    "dataType": "text",
                    "name": "engagementTitle"
                  },
                  {
                    "dataType": "text",
                    "name": "engagementPurpose"
                  },
                  {
                    "dataType": "number",
                    "name": "engagementNoParticipants"
                  },
                  {
                    "dataType": "date",
                    "name": "activityDateFrom"
                  },
                  {
                    "dataType": "date",
                    "name": "activityDateTo"
                  }
                ]
              },
              {
                "dataType": "text",
                "name": "engagementType"
              },
              {
                "dataType": "number",
                "name": "numberOfEngagements"
              },
              {
                "dataType": "number",
                "name": "numberOfParticipants",
                "decimalPlaces": 0,
                "computed": {
                  "expression": "sum(engagementDetails, \"engagementNoParticipants\")"
                }
              }
            ]
          },
          {
            "name": "projectPlans",
            "dataType": "list",
            "allowRowDelete": false,
            "columns": [
              {
                "dataType": "text",
                "name": "planName",
                "readonly": true
              },
              {
                "dataType": "text",
                "name": "planPurpose",
                "readonly": true
              }
            ]
          },
          {
            "dataType": "number",
            "name": "numberOfPlans",
            "decimalPlaces": 0,
            "computed": {
              "expression": "count(projectPlans, \"planName\")"
            }
          },
          {
            "name": "planningMeetings",
            "dataType": "list",
            "allowRowDelete": false,
            "columns": [
              {
                "name": "meetingDateFrom",
                "dataType": "date",
                "readonly": true
              },
              {
                "name": "meetingDateTo",
                "dataType": "date",
                "readonly": true
              },
              {
                "dataType": "text",
                "name": "meetingName",
                "readonly": true
              },
              {
                "dataType": "text",
                "name": "meetingDescription",
                "readonly": true
              }
            ]
          },
          {
            "dataType": "number",
            "name": "numberOfMeetings",
            "decimalPlaces": 0,
            "computed": {
              "expression": "count(planningMeetings, \"meetingName\")"
            }
          },
          {
            "dataType": "number",
            "name": "numberOfCommunityGroupsSupported",
            "validate": "required,min[0]"
          }
        ],
        "modelName": "FNDP Annual Report",
        "title": "Annual Project Services Report",
        "viewModel": [
          {
            "type": "row",
            "items": [
              {
                "preLabel": "1. Please outline the key Project achievements over the past 12 months, including emerging trends from monitoring, and progress against your Project MERI Plan Outcomes.",
                "source": "keyAchievements",
                "type": "textarea",
                "rows": 4
              }
            ]
          },
          {
            "type": "row",
            "items": [
              {
                "source": "<h4>2. MERI and adaptive management</h4>",
                "type": "literal"
              }
            ]
          },
          {
            "type": "row",
            "items": [
              {
                "preLabel": "2.a Have all adaptive management actions identified in the MERIT quarterly output reports over the last 12 months been reflected in the MERI plan?",
                "source": "adaptiveManagementActions",
                "type": "selectOne",
                "rows": 4
              }
            ]
          },
          {
            "type": "row",
            "items": [
              {
                "preLabel": "If no, please provide details of the adaptive management actions that will need to be included as changes to the MERI plan.",
                "source": "noAdaptiveManagementActions",
                "type": "textarea",
                "rows": 4
              }
            ]
          },
          {
            "computed": null,
            "type": "col",
            "items": [
              {
                "boxed": true,
                "title": "",
                "type": "section",
                "items": [
                  {
                    "computed": null,
                    "type": "row",
                    "items": [
                      {
                        "computed": null,
                        "type": "row",
                        "items": [
                          {
                            "source": "<b>2.b Please review the risks and threats table and update if in the last 12 months there have been<ul><li>any risks that have been realised or have newly emerged</li><li>any adaptive management actions that have impacted existing risks</li><li>any mitigation strategies that have been identified as ineffective.</li></ul></b>",
                            "type": "literal"
                          }
                        ]
                      },
                      {
                        "type": "col",
                        "items": [
                          {
                            "preLabel": "◦ Reviewed and updated or",
                            "source": "reviewedAndUpdatedQ3",
                            "type": "selectOne"
                          },
                          {
                            "preLabel": "◦ Reviewed and no change",
                            "source": "reviewedAndNoChangeQ3",
                            "type": "selectOne"
                          }
                        ]
                      }
                    ]
                  }
                ],
                "class": ""
              }
            ]
          },
          {
            "type": "row",
            "items": [
              {
                "source": "<h4>3. Progress against Project Services forecasts</h4>",
                "type": "literal"
              }
            ]
          },
          {
            "disableTableUpload": true,
            "columns": [
              {
                "readonly": true,
                "width": "15%",
                "source": "serviceName",
                "type": "textarea",
                "rows": 3,
                "title": "Project Service"
              },
              {
                "readonly": true,
                "width": "20%",
                "source": "targetMeasure",
                "type": "textarea",
                "rows": 3,
                "title": "Target measure"
              },
              {
                "readonly": true,
                "width": "13%",
                "source": "annualTarget",
                "type": "text",
                "title": "Minimum annual target (for this reporting period)"
              },
              {
                "readonly": true,
                "width": "12%",
                "source": "result",
                "type": "text",
                "title": "Actual achievement"
              },
              {
                "width": "40%",
                "source": "reasonTargetNotMet",
                "type": "textarea",
                "rows": 3,
                "title": "Explanation of target under or over delivery (500 character, [approx. 100 word] limit)"
              }
            ],
            "userAddedRows": false,
            "source": "minimumAnnualTargetsNotMet",
            "title": "Please provide details on progress where delivery has varied from proposed targets.",
            "type": "table"
          },
          {
            "type": "row",
            "items": [
              {
                "source": "<h4>4. Project Workplace Health and Safety (WHS) Risk</h4>",
                "type": "literal"
              }
            ]
          },
          {
            "computed": null,
            "type": "col",
            "items": [
              {
                "boxed": true,
                "title": "",
                "type": "section",
                "items": [
                  {
                    "computed": null,
                    "type": "row",
                    "items": [
                      {
                        "computed": null,
                        "type": "row",
                        "items": [
                          {
                            "source": "<b>4.a Please review the project WHS risk register and update if in the last 12 months there have been <br><ul><li>any WHS risks that have been realised or have newly emerged</li><li>any mitigation strategies that have been identified as ineffective.</li></ul></b>",
                            "type": "literal"
                          }
                        ]
                      },
                      {
                        "type": "col",
                        "items": [
                          {
                            "preLabel": "◦ Reviewed and updated or",
                            "source": "reviewedAndUpdatedQ5",
                            "type": "selectOne"
                          },
                          {
                            "preLabel": "◦ Reviewed and no change",
                            "source": "reviewedAndNoChangeQ5",
                            "type": "selectOne"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "computed": null,
                    "type": "row",
                    "items": [
                      {
                        "source": "<b>If reviewed and updated, please email a copy of the updated project WHS risk register to your contract manager.</b>",
                        "type": "literal"
                      }
                    ]
                  }
                ],
                "class": ""
              }
            ]
          },
          {
            "type": "row",
            "items": [
              {
                "source": "<h4>5. First Nations Delivery Partners Project Support and Overheads Summary Data Tables</h4>",
                "type": "literal"
              }
            ]
          },
          {
            "type": "row",
            "items": [
              {
                "source": "<b>5.a This report aggregates data from the Project Support & Overheads fields reported in the last 12 months through quarterly reporting. Please review for accuracy.</b>",
                "type": "literal"
              }
            ]
          },
          {
            "computed": null,
            "type": "col",
            "items": [
              {
                "boxed": true,
                "title": "",
                "type": "section",
                "items": [
                  {
                    "type": "row",
                    "items": [
                      {
                        "readonly": "readonly",
                        "type": "number",
                        "source": "totalFteEquivalent",
                        "preLabel": "Total FTE supporting and/or delivering the project in the last 12 months"
                      }
                    ]
                  },
                  {
                    "computed": null,
                    "type": "row",
                    "items": [
                      {
                        "type": "row",
                        "items": [
                          {
                            "css": "span8",
                            "source": "<b>5.b Please review and confirm the auto calculated FTE supporting and/or delivering the project for the last 12 months.</b>",
